rules_version = '2';

// ──────────────────────────────────────────────────────────────
//  Bookshelf 安全規則（Phase B-4：社群互動）
//  原則：使用者檔案/共享書庫/評論/追蹤/動態/討論皆公開可讀；
//        私人書架預設私密;寫入一律只能寫「自己的」那一份。
// ──────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ① 使用者公開檔案
    match /users/{uid} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      // 私人書架：本人永遠可讀寫;別人只有當本人 shelfPublic=true 才可讀
      match /books/{bookId} {
        allow write: if request.auth != null && request.auth.uid == uid;
        allow read:  if (request.auth != null && request.auth.uid == uid)
                     || (exists(/databases/$(database)/documents/users/$(uid))
                         && get(/databases/$(database)/documents/users/$(uid)).data.shelfPublic == true);
        match /reviews/{rid} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // 追蹤：我管理「我追蹤誰」
      match /following/{targetUid} {
        allow read:  if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // 粉絲:某人把「自己」加進/移出我的粉絲名單(追蹤我時)
      match /followers/{followerUid} {
        allow read:  if true;
        allow write: if request.auth != null && request.auth.uid == followerUid;
      }
    }

    // ② 舊扁平書庫 → 完全鎖死
    match /books/{document=**} {
      allow read, write: if false;
    }

    // ③ 共享書庫
    match /catalog/{bookId} {
      allow read:  if true;
      allow write: if request.auth != null;

      // 公開評論：一人一書一則(uid 當 id),只能改自己的
      match /reviews/{reviewerUid} {
        allow read:                   if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == reviewerUid;

        // 評論回覆:大家可讀,只能新增/改/刪自己寫的(uid 存在資料裡)
        match /replies/{replyId} {
          allow read:   if true;
          allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
          allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
        }
      }

      // 每本書的公開「讀書會」討論區
      match /discussion/{msgId} {
        allow read:   if true;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }
    }

    // ④ 全站動態事件流(誰評了/在讀/讀完)
    match /activity/{id} {
      allow read:   if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
