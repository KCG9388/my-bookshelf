rules_version = '2';

// ──────────────────────────────────────────────────────────────
//  Bookshelf 安全規則（Phase B-1）
//  原則：使用者檔案公開可讀（只放非敏感欄位）；書架私密；
//        舊書庫鎖死；共享書庫大家可讀、評論只能改自己的。
// ──────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ① 使用者公開檔案：顯示名稱 / 頭像 / 隱私開關
    //    大家可讀（評論要顯示作者名、之後探索頁要顯示使用者），本人可寫。
    //    email 等敏感資料不放這份文件，所以公開讀無妨。
    match /users/{uid} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      // 私人書架：目前只有本人可讀寫。
      //   （B3 會在此加上「若本人把 shelfPublic 設為 true，他人才可讀」的條件）
      match /books/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // 書架底下的舊「私人評論」子集合 — 維持本人專屬
        match /reviews/{rid} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // ② 舊的扁平書庫（你的 189 本）→ 完全鎖死，誰都不能讀/寫/刪。
    //    已不再使用，種子改由各使用者登入時從自己書架補進 catalog。
    match /books/{document=**} {
      allow read, write: if false;
    }

    // ③ 共享書庫 catalog：匿名書目，大家可讀；登入者可建立 / 補資料。
    match /catalog/{bookId} {
      allow read:  if true;
      allow write: if request.auth != null;

      // 公開評論：用「評論者 uid」當文件 id → 天然保證一人一書一則。
      //   大家都看得到；但只能新增 / 修改 / 刪除自己那一則。
      match /reviews/{reviewerUid} {
        allow read:                   if true;
        allow create, update, delete: if request.auth != null
                                       && request.auth.uid == reviewerUid;
      }
    }
  }
}
